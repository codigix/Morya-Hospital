<?xml version="1.0" encoding="utf-8"?>
<!-- the root web configuration file -->
<configuration>
  <system.web>
    <compilation tempDirectory="G:\PleskVhosts\bodymassagebymaletofemale.com\tmp" />
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Blog old url" stopProcessing="true">
