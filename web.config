<?xml version="1.0" encoding="utf-8"?>
<!-- the root web configuration file -->
<configuration>
  <system.web>
    <compilation tempDirectory="G:\PleskVhosts\bodymassagebymaletofemale.com\tmp" />
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Blog slug html" stopProcessing="true">
          <match url="^blog\.html/([^/]+)\.html$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="blog-details.html" />
        </rule>
        <rule name="Service slug html" stopProcessing="true">
          <match url="^(emergency-hospital-pcmc|icu-hospital-pcmc|trauma-care-hospital-chinchwad-pcmc|affordable-hospital-pcmc|orthopedic-hospital-pcmc|knee-replacement-hospital-pune|joint-pain-treatment-pcmc|spine-specialist-chinchwad|sports-injury-treatment-pune|arthritis-treatment-hospital-pcmc|back-pain-treatment-pcmc|hearing-loss-treatment-pune|best-cochlear-implant-surgeon-pune|cochlear-implant-pune-pcmc|hearing-aids-pcmc|advanced-ent-services-chinchwad|advanced-physiotherapy-services-chinchwad|laboratory-blood-investigations-pcmc|cataract-surgery-pcmc|ear-surgery-hospital-pune|deafness-treatment-hospitalin-pcmc|vision-loss-treatment-pcmc|cardiologist-in-chinchwad|phototherapy-treatment-vitiligo-pcmc|heart-specialist-in-pcmc|ecg-test-pcmc|chest-pain-treatment-hospital-pcmc|hypertension-treatment-pune|neurosurgery-hospital-pcmc|stroke-treatment-hospital-pcmc|paralysis-treatment-pune-pcmc|epilepsy-treatment-pcmc|child-specialist-in-chinchwad|vaccination-centre-pcmc|ct-scan-centre-pcmc|dietitian-in-chinchwad)\.html$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="service-details.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>