        <rule name="Blog slug html" stopProcessing="true">
          <match url="^(ear-surgery-hospital-in-pune|cataract-surgery-in-pcmc|ent-specialist-pcmc|urologist-in-pcmc-urinary-problems-men|family-healthcare-in-pimpri-chinchwad|complete-healthcare-in-pimpri-chinchwad|cochlear-implant-hospital-pune|brain-and-spine-surgery-in-pcmc|expert-ent-care-in-pune|hearing-loss-in-children|cochlear-Implant-Surgeon|cochlear-implant-pcmc|orthopedic-treatment-pimpri-chinchwad|best-cochlear-implant-hospital-in-pune|cochlear-implant-in-pune|top-hospital-in-pimpri-chinchwad|best-hospital-in-pcmc-moraya-hospital|best-multispeciality-hospital-in-pcmc|hospital-near-me-in-chinchwad|hospital-in-chinchwad-emergency-specialist-care|hospital-in-chinchwad|healthcare-services-in-pcmc|affordable-hospital-in-pcmc-guide|best-hospital-near-pcmc|child-healthcare-services-near-me-chinchwad|hospital-in-chinchwad-pcmc|orthopaedic-care-in-pcmc|best-ent-specialist-in-pcmc|physiotherapy-and-sports-injury-rehabilitation-in-pcmc|best-cochlear-implant-surgeon-near-me-pune|emergency-hospital-in-chinchwad|healthcare-services-in-chinchwad|cardiologist-in-PCMC|neurology-hospital-chinchwad|ent-specialist-chinchwad|best-hospital-chinchwad-family-care|trauma-care-hospital-chinchwad|knee-pain-treatment-chinchwad|best-ent-hospital-chinchwad|best-pediatric-hospital-pcmc|cardiology-hospital-pcmc|affordable-healthcare-chinchwad-moraya-hospital|stroke-treatment-chinchwad-emergency-care|orthopaedic-hospital-chinchwad|cochlear-implant-pimpri-chinchwad)\.html$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="blog-details.html" />
        </rule>
        <rule name="Service slug html" stopProcessing="true">
          <match url="^(emergency-hospital-pcmc|icu-hospital-pcmc|trauma-care-hospital-chinchwad-pcmc|affordable-hospital-pcmc|orthopedic-hospital-pcmc|knee-replacement-hospital-pune|joint-pain-treatment-pcmc|spine-specialist-chinchwad|sports-injury-treatment-pune|arthritis-treatment-hospital-pcmc|back-pain-treatment-pcmc|hearing-loss-treatment-pune|best-cochlear-implant-surgeon-pune|cochlear-implant-pune-pcmc|hearing-aids-pcmc|advanced-ent-services-chinchwad|advanced-physiotherapy-services-chinchwad|laboratory-blood-investigations-pcmc|cataract-surgery-pcmc|ear-surgery-hospital-pune|deafness-treatment-hospitalin-pcmc|vision-loss-treatment-pcmc|cardiologist-in-chinchwad|phototherapy-treatment-vitiligo-pcmc|heart-specialist-in-pcmc|ecg-test-pcmc|chest-pain-treatment-hospital-pcmc|hypertension-treatment-pune|neurosurgery-hospital-pcmc|stroke-treatment-hospital-pcmc|paralysis-treatment-pune-pcmc|epilepsy-treatment-pcmc|child-specialist-in-chinchwad|vaccination-centre-pcmc|ct-scan-centre-pcmc|dietitian-in-chinchwad)\.html$" />
